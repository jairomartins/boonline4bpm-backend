# Backend Express. Copie para .env local; nunca versionar credenciais.
PORT=3001
NODE_ENV=production
BASE_URL=localhost
USE_HTTPS=false
# URI explícita obrigatória para migrações/seeds. Confirme host e nome do banco.
MONGO=mongodb://127.0.0.1:27017/boonline
CORS_ORIGIN=http://localhost:3000,https://jmartins.vps-kinghost.net
PUBLIC_VALIDATION_BASE_URL=https://boonline.example.org
# URL pública usada nos links de confirmação e recuperação de senha.
PUBLIC_APP_URL=https://boonline.example.org/api
SECRET_PASSWORD_TOKEN=
EMAIL_USER=
EMAIL_PASSWORD=
